# OpenRouter API (Free model via OpenAI-compatible endpoint)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
OPENROUTER_FALLBACK_MODELS=liquid/lfm-3-1.7b:free,nvidia/nemotron-3-ultra-550b-a55b:free

# Scraper Polite Identity
USER_AGENT_EMAIL=student@example.com
USER_AGENT_BOT_NAME=AssignmentResearchBot/1.0

# Base URLs
DARGLOBAL_BASE_URL=https://darglobal.co.uk

# Scraper Limits & Delays
MIN_CRAWL_DELAY=2.0
JITTER_MIN=0.5
JITTER_MAX=1.5
REQUEST_TIMEOUT=20.0
MAX_RETRIES=3
BACKOFF_FACTOR=2.0
MAX_PAGES_PER_RUN=150
MAX_PAGES_PER_DOMAIN=100
CACHE_DIR=data/raw/cache

# API & UI
API_URL=http://localhost:8000
ENABLE_SCRAPE_ENDPOINT=false
